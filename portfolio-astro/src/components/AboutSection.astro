---
import { personal } from '../data/personal';
---

<section id="about" class="py-16">
  <h2 class="text-3xl font-bold text-center gradient-text">About Me</h2>
  <div class="mt-8 max-w-2xl mx-auto glass rounded-3xl p-6 md:p-10 space-y-4 text-gray-600 dark:text-gray-300 leading-relaxed">
    <p>{personal.bio}</p>
    <p>I'm passionate about building products that solve real-world problems — from AI-powered learning platforms to commercial Computer-Based Testing systems sold to multiple institutions.</p>
    <p>My mission is to create high‑impact, scalable software while making quality education and career guidance accessible to every student.</p>
  </div>
</section>
