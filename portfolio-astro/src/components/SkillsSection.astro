---
const skillCategories = [
  {
    title: 'Languages',
    items: ['Python', 'SQL', 'JavaScript', 'HTML/CSS'],
  },
  {
    title: 'Backend',
    items: ['Flask', 'FastAPI', 'REST APIs', 'WebSockets'],
  },
  {
    title: 'AI / ML',
    items: ['LangChain', 'PyTorch', 'Hugging Face', 'scikit-learn', 'Gemini API', 'DeepSeek'],
  },
  {
    title: 'Databases',
    items: ['MySQL', 'PostgreSQL', 'SQLite', 'Qdrant', 'Neo4j'],
  },
  {
    title: 'DevOps & Cloud',
    items: ['Docker', 'Git', 'GitHub Actions', 'AWS S3', 'Cloudflare'],
  },
  {
    title: 'Other Tools',
    items: ['Stripe', 'Razorpay', 'PyInstaller', 'Tkinter', 'React'],
  },
];
---

<section id="skills" class="py-16">
  <h2 class="text-3xl font-bold text-center gradient-text">Skills & Technologies</h2>
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
    {skillCategories.map((cat) => (
      <div class="glass rounded-2xl p-6">
        <h3 class="text-xl font-semibold mb-4">{cat.title}</h3>
        <div class="flex flex-wrap gap-2">
          {cat.items.map((skill) => (
            <span class="px-3 py-1 rounded-full bg-indigo-100/50 dark:bg-indigo-900/30 text-sm font-medium border border-indigo-200/50 dark:border-indigo-800/30">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
