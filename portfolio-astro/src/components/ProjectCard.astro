---
const { p } = Astro.props;
---
<div class="card project-card">
  <div class="proj-image">
    <img src={p.image} alt={p.title} loading="lazy" />
    {p.commercial && <span class="tag-commercial">Commercial</span>}
  </div>
  <div class="proj-body">
    <span class="proj-category">{p.category}</span>
    <h3>{p.title}</h3>
    <p>{p.description}</p>
    <div class="proj-tech">
      {p.tech.map((t: string) => <span>{t}</span>)}
    </div>
    <div class="proj-links">
      {p.live && <a href={p.live} target="_blank" class="btn btn-outline btn-sm">Live ↗</a>}
      <a href={p.github} target="_blank" class="btn btn-outline btn-sm"><i class="fab fa-github"></i> Code</a>
    </div>
  </div>
</div>

<style>
  .project-card { overflow: hidden; display: flex; flex-direction: column; }
  .proj-image { position: relative; aspect-ratio: 16/10; overflow: hidden; }
  .proj-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .project-card:hover .proj-image img { transform: scale(1.06); }
  .tag-commercial {
    position: absolute; top: 12px; right: 12px; background: var(--gradient-2);
    color: #06070d; font-size: 0.7rem; font-weight: 700; padding: 5px 12px;
    border-radius: 100px; text-transform: uppercase;
  }
  .proj-body { padding: 24px; flex: 1; display: flex; flex-direction: column; }
  .proj-category { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-2); font-weight: 600; }
  .proj-body h3 { font-size: 1.2rem; margin: 10px 0 8px; }
  .proj-body p { color: var(--text-dim); font-size: 0.9rem; flex: 1; }
  .proj-tech { display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0; }
  .proj-tech span { font-size: 0.72rem; padding: 4px 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 100px; color: var(--text-dim); }
  .proj-links { display: flex; gap: 10px; }
  .btn-sm { padding: 9px 16px; font-size: 0.82rem; }
</style>
