---
import type { Project } from '../data/projects';
export interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<div class="glass rounded-2xl overflow-hidden flex flex-col transition-transform hover:scale-[1.02] duration-200">
  {project.image && (
    <img src={project.image} alt={project.title} class="w-full h-48 object-cover" loading="lazy" />
  )}
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-xl font-bold">{project.title}</h3>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 flex-1">{project.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.tech.map(t => (
        <span class="px-2 py-1 text-xs rounded-full bg-indigo-100/50 dark:bg-indigo-900/30 border border-indigo-200/50 dark:border-indigo-800/30">
          {t}
        </span>
      ))}
    </div>
    {project.commercial && (
      <span class="mt-2 inline-block text-xs font-bold text-yellow-600 dark:text-yellow-400 bg-yellow-100/70 dark:bg-yellow-900/30 px-3 py-1 rounded-full">💰 Commercial</span>
    )}
    <div class="mt-4 flex gap-3">
      {project.github && (
        <a href={project.github} target="_blank" class="text-sm font-medium text-indigo-500 hover:underline">GitHub →</a>
      )}
      {project.live && (
        <a href={project.live} target="_blank" class="text-sm font-medium text-indigo-500 hover:underline">Live Demo →</a>
      )}
    </div>
  </div>
</div>
