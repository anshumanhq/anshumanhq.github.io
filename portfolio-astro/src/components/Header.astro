---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="glass sticky top-0 z-50 border-b border-white/10 dark:border-white/5">
  <div class="container mx-auto flex items-center justify-between px-4 py-3 max-w-5xl">
    <a href="/" class="text-2xl font-bold tracking-tight">
      Anshuman<span class="gradient-text">Singh</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/" class="hover:text-indigo-400 transition">Home</a>
      <a href="/about" class="hover:text-indigo-400 transition">About</a>
      <a href="/projects" class="hover:text-indigo-400 transition">Projects</a>
      <a href="/contact" class="hover:text-indigo-400 transition">Contact</a>
    </nav>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button class="md:hidden text-2xl" aria-label="Toggle menu">☰</button>
    </div>
  </div>
</header>
