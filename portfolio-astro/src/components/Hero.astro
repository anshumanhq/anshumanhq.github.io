---
import { personal } from '../data/personal';
import SocialLinks from './SocialLinks.astro';
---

<section class="py-16 md:py-24">
  <div class="flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight">
        Hi, I'm <span class="gradient-text">{personal.name}</span>
      </h1>
      <p class="mt-3 text-xl text-gray-600 dark:text-gray-300">{personal.title}</p>
      <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-lg mx-auto md:mx-0">
        {personal.bio}
      </p>
      <div class="mt-6 flex flex-wrap gap-4 justify-center md:justify-start">
        <a href="/projects" class="px-6 py-2 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold hover:scale-105 transition-transform">View Projects →</a>
        <a href="/contact" class="px-6 py-2 rounded-full glass border border-white/20 font-semibold hover:bg-white/20 transition">Contact</a>
      </div>
      <div class="mt-6 flex justify-center md:justify-start">
        <SocialLinks />
      </div>
    </div>
    <div class="flex-shrink-0">
      <img src="/profile.jpg" alt="Anshuman Singh" class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover border-4 border-indigo-400 shadow-2xl" />
    </div>
  </div>
  <div class="mt-12 grid grid-cols-3 gap-4 text-center max-w-lg mx-auto">
    <div class="glass rounded-2xl p-4">
      <div class="text-2xl font-bold text-indigo-400">{personal.stats.projects}</div>
      <div class="text-sm text-gray-600 dark:text-gray-400">Projects Built</div>
    </div>
    <div class="glass rounded-2xl p-4">
      <div class="text-2xl font-bold text-indigo-400">{personal.stats.clients}</div>
      <div class="text-sm text-gray-600 dark:text-gray-400">Clients Served</div>
    </div>
    <div class="glass rounded-2xl p-4">
      <div class="text-2xl font-bold text-indigo-400">{personal.stats.followers}</div>
      <div class="text-sm text-gray-600 dark:text-gray-400">LinkedIn Followers</div>
    </div>
  </div>
</section>
