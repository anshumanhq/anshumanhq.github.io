---
import { personal } from '../data/personal';
---
<div class="flex gap-4">
  <a href={personal.social.github} target="_blank" class="text-2xl hover:text-indigo-400 transition" aria-label="GitHub">
    <span class="i-mdi-github">🐙</span>
  </a>
  <a href={personal.social.linkedin} target="_blank" class="text-2xl hover:text-indigo-400 transition" aria-label="LinkedIn">
    <span class="i-mdi-linkedin">🔗</span>
  </a>
  <a href={personal.social.email} target="_blank" class="text-2xl hover:text-indigo-400 transition" aria-label="Email">
    <span class="i-mdi-email">📧</span>
  </a>
  <a href={personal.social.orcid} target="_blank" class="text-2xl hover:text-indigo-400 transition" aria-label="ORCID">
    <span class="i-mdi-orcid">📝</span>
  </a>
</div>
