---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import research from '../data/research.json';
---
<Layout title="Research | Anshuman Singh" path="/research/">
  <Nav path="/research/" />

  <section class="page-hero">
    <h1>📄 Research</h1>
    <p>Publications and independent research at the intersection of Physics and AI.</p>
  </section>

  <section class="section">
    {research.map(r => (
      <div class="card research-card">
        <img src={r.image} alt={r.title} loading="lazy" />
        <div class="research-body">
          <span class="research-tag">{r.type} · {r.year}</span>
          <h3>{r.title}</h3>
          <p class="research-meta">{r.authors} · {r.journal}</p>
          <p class="research-abstract">{r.abstract}</p>
          <div class="research-tags">
            {r.tags.map(t => <span>{t}</span>)}
          </div>
          <div class="research-links">
            <a href={r.url} target="_blank" class="btn btn-outline btn-sm">View Paper ↗</a>
            {r.doi && <span class="doi">DOI: {r.doi}</span>}
          </div>
        </div>
      </div>
    ))}
  </section>

  <Footer />
</Layout>

<style>
  .research-card { display: grid; grid-template-columns: 280px 1fr; overflow: hidden; margin-bottom: 24px; }
  .research-card img { width: 100%; height: 100%; object-fit: cover; }
  .research-body { padding: 28px; }
  .research-tag { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-2); font-weight: 600; }
  .research-body h3 { font-size: 1.3rem; margin: 10px 0 6px; }
  .research-meta { color: var(--text-dim); font-size: 0.85rem; margin-bottom: 12px; }
  .research-abstract { color: var(--text-dim); font-size: 0.92rem; margin-bottom: 16px; }
  .research-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .research-tags span { font-size: 0.75rem; padding: 5px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 100px; }
  .research-links { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .doi { color: var(--text-dim); font-size: 0.8rem; }
  .btn-sm { padding: 9px 16px; font-size: 0.82rem; }
  @media (max-width: 700px) {
    .research-card { grid-template-columns: 1fr; }
    .research-card img { height: 200px; }
  }
</style>
