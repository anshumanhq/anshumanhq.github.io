---
import BaseLayout from '../layouts/BaseLayout.astro';
import { personal } from '../data/personal';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout title="Contact" description="Get in touch with Anshuman Singh for collaborations, opportunities, or inquiries.">
  <div class="py-8 max-w-2xl mx-auto">
    <h1 class="text-4xl font-bold text-center gradient-text">Get In Touch</h1>
    <div class="mt-8 glass rounded-3xl p-8 space-y-6">
      <p class="text-center text-gray-600 dark:text-gray-300">I'm always open to discussing new opportunities, research collaborations, or just connecting with fellow developers.</p>
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="text-xl">📧</span>
          <a href={personal.social.email} class="hover:text-indigo-400 transition">{personal.social.email.replace('mailto:', '')}</a>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xl">🔗</span>
          <a href={personal.social.linkedin} target="_blank" class="hover:text-indigo-400 transition">LinkedIn</a>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xl">🐙</span>
          <a href={personal.social.github} target="_blank" class="hover:text-indigo-400 transition">GitHub</a>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xl">📝</span>
          <a href={personal.social.orcid} target="_blank" class="hover:text-indigo-400 transition">ORCID</a>
        </div>
      </div>
      <div class="flex justify-center pt-4">
        <SocialLinks />
      </div>
    </div>
  </div>
</BaseLayout>
