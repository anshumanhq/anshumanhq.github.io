---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

const featured = projects.filter(p => p.featured).slice(0, 6);
---
<Layout path="/">
  <Nav path="/" />

  <section class="hero">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="badge">🔬 BTech CSE · Class of 2030</span>
        <h1 class="heading-font">Hi, I'm <span class="gradient-text">Anshuman Singh</span></h1>
        <p class="tagline">AI/ML Engineer · Full-Stack Developer · Physics Researcher</p>
        <p class="desc">
          I build scalable AI systems, commercial software, and free educational tools
          to help students navigate their academic journey — currently focused on
          Generative AI, Knowledge Graphs, and Data Science.
        </p>
        <div class="hero-actions">
          <a href="/projects/" class="btn btn-primary">🚀 View My Work</a>
          <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/anshuman-singh-662183303/" target="_blank" class="btn btn-outline">LinkedIn ↗</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/profile.jpg" alt="Anshuman Singh" />
      </div>
    </div>

    <div class="container hero-stats">
      <div class="stat-card"><span class="stat-num gradient-text">6+</span><span>Clients Served</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">60+</span><span>Projects Built</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">1.6K+</span><span>LinkedIn Followers</span></div>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">Featured Work</div>
    <h2 class="heading-font">Projects that <span class="gradient-text">ship & scale</span></h2>
    <div class="projects-grid">
      {featured.map(p => <ProjectCard p={p} />)}
    </div>
    <div class="center-btn"><a href="/projects/" class="btn btn-outline">View All Projects →</a></div>
  </section>

  <section class="quick-links-section">
    <div class="container quick-grid">
      <a href="/about/" class="quick-card"><span class="quick-icon">👨‍💻</span><h3>About Me</h3><p>My journey, mission, and vision.</p></a>
      <a href="/skills/" class="quick-card"><span class="quick-icon">🛠️</span><h3>Skills</h3><p>Languages, frameworks & tools.</p></a>
      <a href="/research/" class="quick-card"><span class="quick-icon">📄</span><h3>Research</h3><p>Publications & research interests.</p></a>
      <a href="/contact/" class="quick-card"><span class="quick-icon">📬</span><h3>Contact</h3><p>Let's collaborate.</p></a>
    </div>
  </section>

  <div class="container ad-container">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2633513915753897" data-ad-slot="2339071842" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <Footer />
</Layout>

<style>
  .hero { position: relative; padding: 150px 24px 60px; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; z-index: 0; }
  .orb1 { width: 460px; height: 460px; background: var(--accent); top: -140px; right: -100px; }
  .orb2 { width: 360px; height: 360px; background: var(--accent-2); bottom: -80px; left: -80px; }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; align-items: center; }
  .badge { margin-bottom: 20px; }
  .hero h1 { font-size: clamp(2.2rem, 5.2vw, 3.6rem); margin: 16px 0; }
  .tagline { color: var(--accent-2); font-weight: 600; font-size: 1.1rem; margin-bottom: 14px; }
  .desc { color: var(--text-dim); max-width: 520px; margin-bottom: 30px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-image { display: flex; justify-content: center; }
  .hero-image img {
    width: 100%; max-width: 320px; aspect-ratio: 1/1; object-fit: cover;
    border-radius: 50%; border: 4px solid var(--accent);
    box-shadow: var(--shadow-glow);
  }
  .hero-stats {
    position: relative; z-index: 1; display: flex; justify-content: center; gap: 20px;
    flex-wrap: wrap; margin-top: 70px; padding-top: 40px; border-top: 1px solid var(--border);
  }
  .stat-card { text-align: center; }
  .stat-num { display: block; font-size: 2.2rem; font-weight: 700; font-family: 'Space Grotesk'; }
  .stat-card span:last-child { color: var(--text-dim); font-size: 0.85rem; }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; margin-top: 44px; }
  .center-btn { text-align: center; margin-top: 40px; }

  .quick-links-section { background: var(--bg-soft); padding: 80px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .quick-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 30px 22px; text-align: center; transition: all 0.3s;
  }
  .quick-card:hover { transform: translateY(-6px); border-color: var(--accent); }
  .quick-icon { font-size: 2rem; display: block; margin-bottom: 14px; }
  .quick-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .quick-card p { color: var(--text-dim); font-size: 0.85rem; }

  .ad-container { padding: 40px 24px; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-image { order: -1; }
    .hero-image img { max-width: 220px; }
    .hero-actions { justify-content: center; }
    .quick-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
