---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import certificates from '../data/certificates.json';

// Fetch LeetCode stats at build time
const leetcodeUsername = 'Anshuman__Singh__';
let leetcodeStats = { totalSolved: 0, ranking: 0, easySolved: 0, mediumSolved: 0, hardSolved: 0 };
let statsError = false;

try {
  const response = await fetch(`https://leetcode-stats-api.herokuapp.com/${leetcodeUsername}`, {
    headers: { 'Accept': 'application/json' }
  });
  if (response.ok) {
    const data = await response.json();
    if (data.status === 'success') {
      leetcodeStats = {
        totalSolved: data.totalSolved || 0,
        ranking: data.ranking || 0,
        easySolved: data.easySolved || 0,
        mediumSolved: data.mediumSolved || 0,
        hardSolved: data.hardSolved || 0,
      };
    } else {
      statsError = true;
    }
  } else {
    statsError = true;
  }
} catch (e) {
  statsError = true;
}

// Get latest 3 certificates (sorted by date descending, newest first)
const recentCerts = certificates
  .sort((a, b) => {
    const dateA = parseInt(a.date);
    const dateB = parseInt(b.date);
    return dateB - dateA;
  })
  .slice(0, 4);

const featured = projects.filter(p => p.featured).slice(0, 6);

const seo = {
  title: "Anshuman Singh | AI/ML Engineer, Full-Stack Developer & Physics Researcher",
  description: "Anshuman Singh — BTech CSE student building scalable AI systems, commercial software, and free EdTech tools. 60+ projects including StudyAI, CBT Portal & UPTAC Seat Predictor. Available for AI/ML & full-stack roles.",
  keywords: "Anshuman Singh, Anshuman Singh AI engineer, Anshuman Singh portfolio, AI ML engineer India, Flask developer India, Python developer BTech, generative AI developer, StudyAI, UPTAC seat predictor, CBT school portal, knowledge graph developer, LangChain developer, hire AI engineer India",
};
---
<Layout title={seo.title} description={seo.description} keywords={seo.keywords} path="/">
  <Nav path="/" />

  <section class="hero">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="badge">🔬 BTech CSE · Class of 2030</span>
        <h1 class="heading-font">Hi, I'm <span class="gradient-text">Anshuman Singh</span></h1>
        <p class="tagline">AI/ML Engineer · Full-Stack Developer · Physics Researcher</p>
        <p class="desc">
          I build scalable AI systems, commercial software, and free educational tools
          to help students navigate their academic journey — currently focused on
          Generative AI, Knowledge Graphs, and Data Science.
        </p>
        <div class="hero-actions">
          <a href="/projects/" class="btn btn-primary">🚀 View My Work</a>
          <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/anshuman-singh-662183303/" target="_blank" class="btn btn-outline">LinkedIn ↗</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/profile.jpg" alt="Anshuman Singh" />
      </div>
    </div>

    <div class="container hero-stats">
      <div class="stat-card"><span class="stat-num gradient-text">6+</span><span>Clients Served</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">60+</span><span>Projects Built</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">1.6K+</span><span>LinkedIn Followers</span></div>
    </div>
  </section>

  <!-- ===== NEW SECTION: Coding Stats ===== -->
  <section class="section coding-stats">
    <div class="eyebrow">Coding Stats</div>
    <h2 class="heading-font">LeetCode &amp; <span class="gradient-text">HackerRank</span></h2>
    <div class="stats-grid">
      <!-- LeetCode Stats -->
      <div class="card stat-box leetcode-box">
        <div class="stat-box-header">
          <img src="https://img.icons8.com/color/48/000000/leetcode.png" alt="LeetCode" />
          <span class="stat-box-title">LeetCode</span>
        </div>
        {statsError ? (
          <p class="stat-error">Unable to fetch live stats. <br /> <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank">View Profile →</a></p>
        ) : (
          <>
            <div class="stat-number">{leetcodeStats.totalSolved}</div>
            <div class="stat-label">Problems Solved</div>
            <div class="stat-breakdown">
              <span>Easy: {leetcodeStats.easySolved}</span>
              <span>Medium: {leetcodeStats.mediumSolved}</span>
              <span>Hard: {leetcodeStats.hardSolved}</span>
            </div>
            <div class="stat-ranking">🏅 Rank: #{leetcodeStats.ranking}</div>
          </>
        )}
        <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank" class="btn btn-outline btn-sm">View Profile →</a>
      </div>

      <!-- HackerRank Badge -->
      <div class="card stat-box hackerrank-box">
        <div class="stat-box-header">
          <img src="https://img.icons8.com/color/48/000000/hackerrank.png" alt="HackerRank" />
          <span class="stat-box-title">HackerRank</span>
        </div>
        <div class="hackerrank-badge">
          <a href="https://www.hackerrank.com/anshumanhq" target="_blank">
            <img src="https://img.shields.io/badge/HackerRank-2EC866?style=for-the-badge&logo=hackerrank&logoColor=white" alt="HackerRank Badge" />
          </a>
          <p class="stat-label">1★ Python · Problem Solving</p>
          <!-- Optional: add more badges like SQL, etc. -->
        </div>
        <a href="https://www.hackerrank.com/anshumanhq" target="_blank" class="btn btn-outline btn-sm">View Profile →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">Featured Work</div>
    <h2 class="heading-font">Projects that <span class="gradient-text">ship & scale</span></h2>
    <div class="projects-grid">
      {featured.map(p => <ProjectCard p={p} />)}
    </div>
    <div class="center-btn"><a href="/projects/" class="btn btn-outline">View All Projects →</a></div>
  </section>

  <!-- Recent Certificates -->
  <section class="section cert-preview">
    <div class="eyebrow">Recent Certificates</div>
    <h2 class="heading-font">Continuous <span class="gradient-text">Learning & Growth</span></h2>
    <div class="cert-preview-grid">
      {recentCerts.map(c => (
        <div class="card cert-preview-card">
          <div class="cert-preview-image">
            <img src={c.image} alt={c.name} loading="lazy" />
          </div>
          <div class="cert-preview-body">
            <span class="cert-preview-issuer">{c.issuer}</span>
            <h3>{c.name}</h3>
          </div>
        </div>
      ))}
    </div>
    <div class="center-btn"><a href="/certificates/" class="btn btn-outline">View All Certificates →</a></div>
  </section>

  <section class="quick-links-section">
    <div class="container quick-grid">
      <a href="/about/" class="quick-card"><span class="quick-icon">👨‍💻</span><h3>About Me</h3><p>My journey, mission, and vision.</p></a>
      <a href="/skills/" class="quick-card"><span class="quick-icon">🛠️</span><h3>Skills</h3><p>Languages, frameworks & tools.</p></a>
      <a href="/research/" class="quick-card"><span class="quick-icon">📄</span><h3>Research</h3><p>Publications & research interests.</p></a>
      <a href="/contact/" class="quick-card"><span class="quick-icon">📬</span><h3>Contact</h3><p>Let's collaborate.</p></a>
    </div>
  </section>

  <div class="container ad-container">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2633513915753897" data-ad-slot="2339071842" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <Footer />
</Layout>

<style>
  .hero { position: relative; padding: 150px 24px 60px; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; z-index: 0; }
  .orb1 { width: 460px; height: 460px; background: var(--accent); top: -140px; right: -100px; }
  .orb2 { width: 360px; height: 360px; background: var(--accent-2); bottom: -80px; left: -80px; }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; align-items: center; }
  .badge { margin-bottom: 20px; }
  .hero h1 { font-size: clamp(2.2rem, 5.2vw, 3.6rem); margin: 16px 0; }
  .tagline { color: var(--accent-2); font-weight: 600; font-size: 1.1rem; margin-bottom: 14px; }
  .desc { color: var(--text-dim); max-width: 520px; margin-bottom: 30px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-image { display: flex; justify-content: center; }
  .hero-image img {
    width: 100%; max-width: 320px; aspect-ratio: 1/1; object-fit: cover;
    border-radius: 50%; border: 4px solid var(--accent);
    box-shadow: var(--shadow-glow);
  }
  .hero-stats {
    position: relative; z-index: 1; display: flex; justify-content: center; gap: 20px;
    flex-wrap: wrap; margin-top: 70px; padding-top: 40px; border-top: 1px solid var(--border);
  }
  .stat-card { text-align: center; }
  .stat-num { display: block; font-size: 2.2rem; font-weight: 700; font-family: 'Space Grotesk'; }
  .stat-card span:last-child { color: var(--text-dim); font-size: 0.85rem; }

  /* ===== Coding Stats Section ===== */
  .coding-stats .heading-font { margin-bottom: 44px; }
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }
  .stat-box {
    padding: 28px 24px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
  }
  .stat-box-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .stat-box-header img {
    width: 32px;
    height: 32px;
  }
  .stat-box-title {
    font-weight: 700;
    font-size: 1.2rem;
    font-family: 'Space Grotesk', sans-serif;
  }
  .stat-number {
    font-size: 3.2rem;
    font-weight: 700;
    font-family: 'Space Grotesk', sans-serif;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.2;
  }
  .stat-label {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 4px 0 12px;
  }
  .stat-breakdown {
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .stat-ranking {
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 16px;
  }
  .stat-error {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin: 20px 0;
  }
  .stat-error a {
    color: var(--accent-2);
  }
  .hackerrank-badge {
    margin: 16px 0;
  }
  .hackerrank-badge img {
    max-width: 100%;
  }
  .btn-sm { padding: 9px 16px; font-size: 0.82rem; }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; margin-top: 44px; }
  .center-btn { text-align: center; margin-top: 40px; }

  .cert-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .cert-preview-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.3s, border-color 0.3s;
  }
  .cert-preview-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .cert-preview-image {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    margin-bottom: 14px;
  }
  .cert-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--bg-soft);
  }
  .cert-preview-issuer {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    font-weight: 600;
  }
  .cert-preview-body h3 {
    font-size: 0.95rem;
    margin-top: 6px;
    line-height: 1.3;
  }

  .quick-links-section { background: var(--bg-soft); padding: 80px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .quick-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 30px 22px; text-align: center; transition: all 0.3s;
  }
  .quick-card:hover { transform: translateY(-6px); border-color: var(--accent); }
  .quick-icon { font-size: 2rem; display: block; margin-bottom: 14px; }
  .quick-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .quick-card p { color: var(--text-dim); font-size: 0.85rem; }

  .ad-container { padding: 40px 24px; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-image { order: -1; }
    .hero-image img { max-width: 220px; }
    .hero-actions { justify-content: center; }
    .quick-grid { grid-template-columns: 1fr 1fr; }
    .cert-preview-grid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
    .stats-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .quick-grid { grid-template-columns: 1fr; }
    .cert-preview-grid { grid-template-columns: 1fr 1fr; }
  }
</style>