---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import certificates from '../data/certificates.json';

// ===== Fetch GitHub Data =====
const githubUsername = 'anshumanhq';
let userData = { name: '', bio: '', public_repos: 0, followers: 0, following: 0, totalStars: 0 };
let contributionsData = [];
let languageCounts = {};
let streakData = { currentStreak: 0, longestStreak: 0 };
let fetchError = false;

try {
    const userRes = await fetch(`https://api.github.com/users/${githubUsername}`);
    if (userRes.ok) {
        const userJson = await userRes.json();
        userData = {
            name: userJson.name || userJson.login,
            bio: userJson.bio || '',
            public_repos: userJson.public_repos || 0,
            followers: userJson.followers || 0,
            following: userJson.following || 0,
            totalStars: 0,
        };
        let page = 1;
        let repos = [];
        while (true) {
            const reposRes = await fetch(`https://api.github.com/users/${githubUsername}/repos?per_page=100&page=${page}`);
            if (!reposRes.ok) break;
            const reposJson = await reposRes.json();
            if (reposJson.length === 0) break;
            repos = repos.concat(reposJson);
            page++;
            if (repos.length >= 1000) break;
        }
        userData.totalStars = repos.reduce((sum, repo) => sum + repo.stargazers_count, 0);

        const langCount = {};
        repos.forEach(repo => {
            if (repo.language) {
                langCount[repo.language] = (langCount[repo.language] || 0) + 1;
            }
        });
        languageCounts = Object.fromEntries(
            Object.entries(langCount)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 6)
        );
    } else {
        fetchError = true;
    }

    const contribRes = await fetch(`https://github-contributions-api.jogruber.de/v4/${githubUsername}`);
    if (contribRes.ok) {
        const contribJson = await contribRes.json();
        if (contribJson.contributions) {
            const startDate = new Date('2026-01-01');
            contributionsData = contribJson.contributions.filter(day => new Date(day.date) >= startDate);

            let currentStreak = 0;
            let longestStreak = 0;
            let streak = 0;
            const sorted = [...contributionsData].sort((a, b) => new Date(b.date) - new Date(a.date));
            for (const day of sorted) {
                if (day.count > 0) {
                    streak++;
                    if (streak > longestStreak) longestStreak = streak;
                } else {
                    if (streak > 0) {
                        if (currentStreak === 0) {
                            currentStreak = streak;
                        }
                        streak = 0;
                    } else {
                        streak = 0;
                    }
                }
            }
            if (currentStreak === 0 && streak > 0) currentStreak = streak;
            streakData = { currentStreak, longestStreak };
        }
    } else {
        contributionsData = [];
    }
} catch (e) {
    fetchError = true;
    console.error('GitHub fetch error:', e);
}

// ===== Get recent certificates =====
const recentCerts = certificates
    .sort((a, b) => {
        const dateA = parseInt(a.date);
        const dateB = parseInt(b.date);
        return dateB - dateA;
    })
    .slice(0, 4);

const featured = projects.filter(p => p.featured).slice(0, 6);

// ===== Build 6‑month heatmap (180 days) =====
function buildHeatmapWeeks(contributions, daysToShow = 180) {
    const today = new Date();
    const startDate = new Date(today);
    startDate.setDate(startDate.getDate() - daysToShow + 1);

    const contribMap = {};
    contributions.forEach(day => {
        const d = new Date(day.date);
        const key =
            `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        contribMap[key] = day.count;
    });

    const weeks = [];
    const current = new Date(startDate);
    const dayOfWeek = current.getDay();
    const diff = (dayOfWeek === 0 ? 6 : dayOfWeek - 1);
    current.setDate(current.getDate() - diff);

    while (current <= today) {
        const week = [];
        for (let i = 0; i < 7; i++) {
            const d = new Date(current);
            const key =
                `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            week.push({
                date: d,
                count: contribMap[key] || 0,
                key: key,
            });
            current.setDate(current.getDate() + 1);
        }
        weeks.push(week);
        if (current > today) break;
    }
    return weeks;
}

const heatmapWeeks = buildHeatmapWeeks(contributionsData, 180); // 6 months

// ===== SEO =====
const seo = {
    title: "Anshuman Singh | AI/ML Engineer, Full-Stack Developer & Physics Researcher",
    description: "Anshuman Singh — BTech CSE student building scalable AI systems, commercial software, and free EdTech tools. 60+ projects including StudyAI, CBT Portal & UPTAC Seat Predictor. Available for AI/ML & full-stack roles.",
    keywords: "Anshuman Singh, Anshuman Singh AI engineer, Anshuman Singh portfolio, AI ML engineer India, Flask developer India, Python developer BTech, generative AI developer, StudyAI, UPTAC seat predictor, CBT school portal, knowledge graph developer, LangChain developer, hire AI engineer India",
};
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords} path="/">
    <Nav path="/" />

    <section class="hero">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="container hero-inner">
            <div class="hero-text">
                <span class="badge">🔬 BTech CSE · Class of 2030</span>
                <h1 class="heading-font">Hi, I'm <span class="gradient-text">Anshuman Singh</span></h1>
                <p class="tagline">AI/ML Engineer · Full-Stack Developer · Physics Researcher</p>
                <p class="desc">
                    I build scalable AI systems, commercial software, and free educational tools
                    to help students navigate their academic journey — currently focused on
                    Generative AI, Knowledge Graphs, and Data Science.
                </p>
                <div class="hero-actions">
                    <a href="/projects/" class="btn btn-primary">🚀 View My Work</a>
                    <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline">GitHub ↗</a>
                    <a href="https://www.linkedin.com/in/anshuman-singh-662183303/" target="_blank"
                    class="btn btn-outline">LinkedIn ↗</a>
                </div>
            </div>
            <div class="hero-image">
                <img src="/profile.jpg" alt="Anshuman Singh" />
            </div>
        </div>

        <div class="container hero-stats">
            <div class="stat-card"><span class="stat-num gradient-text">6+</span><span>Clients Served</span></div>
            <div class="stat-card"><span class="stat-num gradient-text">60+</span><span>Projects Built</span></div>
            <div class="stat-card"><span class="stat-num gradient-text">1.6K+</span><span>LinkedIn Followers</span></div>
        </div>
    </section>

    <!-- ===== Coding Stats: LeetCode + HackerRank ===== -->
    <section class="section coding-stats">
        <div class="eyebrow">Coding Stats</div>
        <h2 class="heading-font">LeetCode &amp; <span class="gradient-text">HackerRank</span></h2>
        <div class="stats-grid">
            <div class="card stat-box leetcode-box">
                <div class="stat-box-header">
                    <img src="https://leetcode.com/_next/static/images/logo-dark-c96c407d175e36c81e236fcfdd682a0b.png"
                    alt="LeetCode" width="64" height="64" />
                    <span class="stat-box-title">LeetCode</span>
                </div>
                <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank">
                    <img src="https://leetcard.jacoblin.cool/Anshuman__Singh__?theme=dark&ext=heatmap"
                    alt="LeetCode Stats"
                    class="leetcode-card-img"
                    loading="lazy" />
                </a>
                <div class="stat-box-cta">
                    <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank" class="btn btn-outline btn-sm">View
                    Profile →</a>
                </div>
            </div>

            <div class="card stat-box hackerrank-box">
                <div class="stat-box-header">
                    <img src="https://avatars.githubusercontent.com/u/7596827?v=4" alt="HackerRank" width="64"
                    height="64" />
                    <span class="stat-box-title">HackerRank</span>
                </div>
                <div class="hackerrank-badges">
                    <div class="badge-item">
                        <img src="https://hrcdn.net/fcore/assets/badges/python-f70befd824.svg" alt="Python Badge"
                        class="badge-icon-img" loading="lazy" />
                        <span class="badge-label">Python</span>
                        <div class="badge-stars">
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                        </div>
                    </div>
                </div>
                <div class="stat-box-cta">
                    <a href="https://www.hackerrank.com/anshumansingh361" target="_blank" class="btn btn-outline btn-sm">View
                    Profile →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== GitHub Stats (FIXED) ===== -->
    <section class="section github-stats">
        <div class="eyebrow">GitHub Analytics</div>
        <h2 class="heading-font">Open Source <span class="gradient-text">Activity</span></h2>

        <!-- ── GitHub Profile Card ── -->
        <div class="github-profile-card card">
            {fetchError ? (
                <p class="stat-error">Unable to fetch live stats. <a href="https://github.com/anshumanhq" target="_blank">View
                    Profile →</a></p>
            ) : (
                <div class="profile-row">
                    <div class="profile-avatar">
                        <img src="https://avatars.githubusercontent.com/u/193123264?v=4" alt="Avatar" width="72"
                        height="72" />
                    </div>
                    <div class="profile-meta">
                        <h3 class="profile-name">{userData.name}</h3>
                        <p class="profile-bio">{userData.bio}</p>
                    </div>
                    <div class="profile-stats">
                        <div class="pstat">
                            <span class="pstat-num">{userData.public_repos}</span>
                            <span class="pstat-label">Repos</span>
                        </div>
                        <div class="pstat">
                            <span class="pstat-num">{userData.totalStars}</span>
                            <span class="pstat-label">Stars</span>
                        </div>
                        <div class="pstat">
                            <span class="pstat-num">{userData.followers}</span>
                            <span class="pstat-label">Followers</span>
                        </div>
                        <div class="pstat">
                            <span class="pstat-num">{userData.following}</span>
                            <span class="pstat-label">Following</span>
                        </div>
                    </div>
                    <div class="profile-cta">
                        <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline btn-sm">View
                        GitHub →</a>
                    </div>
                </div>
            )}
        </div>

        <!-- ── Contributions + Heatmap ── -->
        <div class="github-heatmap-card card">
            {heatmapWeeks.length > 0 ? (
                <>
                    <!-- Streak -->
                    <div class="streak-row">
                        <div class="streak-item">
                            <span class="streak-num">{streakData.currentStreak}</span>
                            <span class="streak-label">Current Streak</span>
                        </div>
                        <div class="streak-divider"></div>
                        <div class="streak-item">
                            <span class="streak-num">{streakData.longestStreak}</span>
                            <span class="streak-label">Longest Streak</span>
                        </div>
                    </div>

                    <!-- Heatmap -->
                    <div class="heatmap-wrapper">
                        <div class="heatmap-grid">
                            {heatmapWeeks.map((week) => (
                                <div class="heatmap-week">
                                    {week.map((day) => {
                                        let color = '#161b22';
                                        if (day.count > 0) {
                                            if (day.count < 3) color = '#0e4429';
                                            else if (day.count < 6) color = '#006d32';
                                            else if (day.count < 10) color = '#26a641';
                                            else color = '#39d353';
                                        }
                                        const isFuture = day.date > new Date();
                                        return (
                                            <div class="heatmap-cell"
                                            style={`background-color: ${isFuture ? '#161b22' : color}; opacity: ${isFuture ? 0.25 : 1};`}
                                            title={isFuture ? 'Future' : `${day.key}: ${day.count} contributions`}
                                        />
                                    );
                                })}
                            </div>
                        ))}
                    </div>
                    <p class="heatmap-footnote">Last 6 months · {contributionsData.reduce((s, d) => s + d.count, 0)} total
                    contributions</p>
                </div>

                <!-- Languages -->
                <div class="lang-section">
                    <span class="lang-label">Top Languages</span>
                    <div class="lang-tags">
                        {Object.keys(languageCounts).length > 0 ? (
                            Object.entries(languageCounts).map(([lang, count]) => (
                                <span class="lang-tag">{lang} <span class="lang-count">{count}</span></span>
                            ))
                        ) : (
                            <span class="lang-tag">No languages detected</span>
                        )}
                    </div>
                </div>
            </>
        ) : (
            <p class="stat-error">Unable to load contributions. <a href="https://github.com/anshumanhq" target="_blank">View
                GitHub</a></p>
        )}
        <div class="heatmap-footer-cta">
            <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline btn-sm">View Full Profile →</a>
        </div>
    </div>
</section>

<!-- ===== Featured Projects ===== -->
<section class="section">
    <div class="eyebrow">Featured Work</div>
    <h2 class="heading-font">Projects that <span class="gradient-text">ship & scale</span></h2>
    <div class="projects-grid">
        {featured.map(p => <ProjectCard p={p} />)}
    </div>
    <div class="center-btn"><a href="/projects/" class="btn btn-outline">View All Projects →</a></div>
</section>

<!-- ===== Recent Certificates ===== -->
<section class="section cert-preview">
    <div class="eyebrow">Recent Certificates</div>
    <h2 class="heading-font">Continuous <span class="gradient-text">Learning & Growth</span></h2>
    <div class="cert-preview-grid">
        {recentCerts.map(c => (
            <div class="card cert-preview-card">
                <div class="cert-preview-image">
                    <img src={c.image} alt={c.name} loading="lazy" />
                </div>
                <div class="cert-preview-body">
                    <span class="cert-preview-issuer">{c.issuer}</span>
                    <h3>{c.name}</h3>
                </div>
            </div>
        ))}
    </div>
    <div class="center-btn"><a href="/certificates/" class="btn btn-outline">View All Certificates →</a></div>
</section>

<!-- ===== Quick Links ===== -->
<section class="quick-links-section">
    <div class="container quick-grid">
        <a href="/about/" class="quick-card"><span class="quick-icon">👨‍💻</span><h3>About Me</h3><p>My journey, mission, and
        vision.</p></a>
        <a href="/skills/" class="quick-card"><span class="quick-icon">🛠️</span><h3>Skills</h3><p>Languages, frameworks &
            tools.</p></a>
        <a href="/research/" class="quick-card"><span class="quick-icon">📄</span><h3>Research</h3><p>Publications & research
            interests.</p></a>
        <a href="/contact/" class="quick-card"><span class="quick-icon">📬</span><h3>Contact</h3><p>Let's collaborate.</p></a>
    </div>
</section>

<div class="container ad-container">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2633513915753897" data-ad-slot="2339071842"
    data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>

<Footer />
</Layout>

