---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import certificates from '../data/certificates.json';

// ===== Fetch GitHub Data =====
const githubUsername = 'anshumanhq';
let userData = { name: '', bio: '', public_repos: 0, followers: 0, following: 0, totalStars: 0 };
let contributionsData = [];
let languageCounts = {};
let streakData = { currentStreak: 0, longestStreak: 0 };
let fetchError = false;

try {
  const userRes = await fetch(`https://api.github.com/users/${githubUsername}`);
  if (userRes.ok) {
    const userJson = await userRes.json();
    userData = {
      name: userJson.name || userJson.login,
      bio: userJson.bio || '',
      public_repos: userJson.public_repos || 0,
      followers: userJson.followers || 0,
      following: userJson.following || 0,
      totalStars: 0,
    };
    let page = 1;
    let repos = [];
    while (true) {
      const reposRes = await fetch(`https://api.github.com/users/${githubUsername}/repos?per_page=100&page=${page}`);
      if (!reposRes.ok) break;
      const reposJson = await reposRes.json();
      if (reposJson.length === 0) break;
      repos = repos.concat(reposJson);
      page++;
      if (repos.length >= 1000) break;
    }
    userData.totalStars = repos.reduce((sum, repo) => sum + repo.stargazers_count, 0);

    const langCount = {};
    repos.forEach(repo => {
      if (repo.language) {
        langCount[repo.language] = (langCount[repo.language] || 0) + 1;
      }
    });
    languageCounts = Object.fromEntries(
      Object.entries(langCount)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 6)
    );
  } else {
    fetchError = true;
  }

  const contribRes = await fetch(`https://github-contributions-api.jogruber.de/v4/${githubUsername}`);
  if (contribRes.ok) {
    const contribJson = await contribRes.json();
    if (contribJson.contributions) {
      const startDate = new Date('2026-01-01');
      contributionsData = contribJson.contributions.filter(day => new Date(day.date) >= startDate);

      let currentStreak = 0;
      let longestStreak = 0;
      let streak = 0;
      const sorted = [...contributionsData].sort((a, b) => new Date(b.date) - new Date(a.date));
      for (const day of sorted) {
        if (day.count > 0) {
          streak++;
          if (streak > longestStreak) longestStreak = streak;
        } else {
          if (streak > 0) {
            if (currentStreak === 0) {
              currentStreak = streak;
            }
            streak = 0;
          } else {
            streak = 0;
          }
        }
      }
      if (currentStreak === 0 && streak > 0) currentStreak = streak;
      streakData = { currentStreak, longestStreak };
    }
  } else {
    contributionsData = [];
  }
} catch (e) {
  fetchError = true;
  console.error('GitHub fetch error:', e);
}

// ===== Get recent certificates =====
const recentCerts = certificates
  .sort((a, b) => {
    const dateA = parseInt(a.date);
    const dateB = parseInt(b.date);
    return dateB - dateA;
  })
  .slice(0, 4);

const featured = projects.filter(p => p.featured).slice(0, 6);

// ===== Build 6‑month heatmap (180 days) =====
function buildHeatmapWeeks(contributions, daysToShow = 180) {
  const today = new Date();
  const startDate = new Date(today);
  startDate.setDate(startDate.getDate() - daysToShow + 1);

  const contribMap = {};
  contributions.forEach(day => {
    const d = new Date(day.date);
    const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    contribMap[key] = day.count;
  });

  const weeks = [];
  const current = new Date(startDate);
  const dayOfWeek = current.getDay();
  const diff = (dayOfWeek === 0 ? 6 : dayOfWeek - 1);
  current.setDate(current.getDate() - diff);

  while (current <= today) {
    const week = [];
    for (let i = 0; i < 7; i++) {
      const d = new Date(current);
      const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      week.push({
        date: d,
        count: contribMap[key] || 0,
        key: key,
      });
      current.setDate(current.getDate() + 1);
    }
    weeks.push(week);
    if (current > today) break;
  }
  return weeks;
}

const heatmapWeeks = buildHeatmapWeeks(contributionsData, 180); // 6 months

// ===== SEO =====
const seo = {
  title: "Anshuman Singh | AI/ML Engineer, Full-Stack Developer & Physics Researcher",
  description: "Anshuman Singh — BTech CSE student building scalable AI systems, commercial software, and free EdTech tools. 60+ projects including StudyAI, CBT Portal & UPTAC Seat Predictor. Available for AI/ML & full-stack roles.",
  keywords: "Anshuman Singh, Anshuman Singh AI engineer, Anshuman Singh portfolio, AI ML engineer India, Flask developer India, Python developer BTech, generative AI developer, StudyAI, UPTAC seat predictor, CBT school portal, knowledge graph developer, LangChain developer, hire AI engineer India",
};
---
<Layout title={seo.title} description={seo.description} keywords={seo.keywords} path="/">
  <Nav path="/" />

  <section class="hero">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="badge">🔬 BTech CSE · Class of 2030</span>
        <h1 class="heading-font">Hi, I'm <span class="gradient-text">Anshuman Singh</span></h1>
        <p class="tagline">AI/ML Engineer · Full-Stack Developer · Physics Researcher</p>
        <p class="desc">
          I build scalable AI systems, commercial software, and free educational tools
          to help students navigate their academic journey — currently focused on
          Generative AI, Knowledge Graphs, and Data Science.
        </p>
        <div class="hero-actions">
          <a href="/projects/" class="btn btn-primary">🚀 View My Work</a>
          <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/anshuman-singh-662183303/" target="_blank" class="btn btn-outline">LinkedIn ↗</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/profile.jpg" alt="Anshuman Singh" />
      </div>
    </div>

    <div class="container hero-stats">
      <div class="stat-card"><span class="stat-num gradient-text">6+</span><span>Clients Served</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">60+</span><span>Projects Built</span></div>
      <div class="stat-card"><span class="stat-num gradient-text">1.6K+</span><span>LinkedIn Followers</span></div>
    </div>
  </section>

  <!-- ===== Coding Stats: LeetCode + HackerRank ===== -->
  <section class="section coding-stats">
    <div class="eyebrow">Coding Stats</div>
    <h2 class="heading-font">LeetCode &amp; <span class="gradient-text">HackerRank</span></h2>
    <div class="stats-grid">
      <div class="card stat-box leetcode-box">
        <div class="stat-box-header">
          <img src="https://leetcode.com/_next/static/images/logo-dark-c96c407d175e36c81e236fcfdd682a0b.png" alt="LeetCode" width="64" height="64" />
          <span class="stat-box-title">LeetCode</span>
        </div>
        <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank">
          <img
            src="https://leetcard.jacoblin.cool/Anshuman__Singh__?theme=dark&ext=heatmap"
            alt="LeetCode Stats"
            class="leetcode-card-img"
            loading="lazy"
          />
        </a>
        <div class="stat-box-cta">
          <a href="https://leetcode.com/Anshuman__Singh__/" target="_blank" class="btn btn-outline btn-sm">View Profile →</a>
        </div>
      </div>

      <div class="card stat-box hackerrank-box">
        <div class="stat-box-header">
          <img src="https://avatars.githubusercontent.com/u/7596827?v=4" alt="HackerRank" width="64" height="64" />
          <span class="stat-box-title">HackerRank</span>
        </div>
        <div class="hackerrank-badges">
          <div class="badge-item">
            <img
              src="https://hrcdn.net/fcore/assets/badges/python-f70befd824.svg"
              alt="Python Badge"
              class="badge-icon-img"
              loading="lazy"
            />
            <span class="badge-label">Python</span>
            <div class="badge-stars">
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
            </div>
          </div>
        </div>
        <div class="stat-box-cta">
          <a href="https://www.hackerrank.com/anshumansingh361" target="_blank" class="btn btn-outline btn-sm">View Profile →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GitHub Stats (6‑month heatmap) ===== -->
  <section class="section github-stats">
    <div class="eyebrow">GitHub Analytics</div>
    <h2 class="heading-font">Open Source <span class="gradient-text">Activity</span></h2>

    <div class="github-grid">
      <!-- User Stats Card -->
      <div class="card stat-box github-box user-stats-box">
        <div class="stat-box-header">
          <img src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" alt="GitHub" width="32" height="32" />
          <span class="stat-box-title">User Stats</span>
        </div>
        {fetchError ? (
          <p class="stat-error">Unable to fetch live stats. <a href="https://github.com/anshumanhq" target="_blank">View Profile →</a></p>
        ) : (
          <>
            <div class="user-detail">
              <div class="user-avatar">
                <img src="https://avatars.githubusercontent.com/u/193123264?v=4" alt="Avatar" width="80" height="80" />
              </div>
              <div class="user-info">
                <h3>{userData.name}</h3>
                <p>{userData.bio}</p>
              </div>
            </div>
            <div class="user-stats-grid">
              <div class="mini-stat">
                <span class="mini-stat-num">{userData.public_repos}</span>
                <span class="mini-stat-label">Repos</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">{userData.totalStars}</span>
                <span class="mini-stat-label">Stars</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">{userData.followers}</span>
                <span class="mini-stat-label">Followers</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">{userData.following}</span>
                <span class="mini-stat-label">Following</span>
              </div>
            </div>
          </>
        )}
        <div class="stat-box-cta">
          <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline btn-sm">View Profile →</a>
        </div>
      </div>

      <!-- Contributions & Heatmap (6 months) -->
      <div class="card stat-box github-box heatmap-box">
        <div class="stat-box-header">
          <img src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" alt="GitHub" width="32" height="32" />
          <span class="stat-box-title">Contributions</span>
        </div>
        {heatmapWeeks.length > 0 ? (
          <>
            <div class="streak-stats">
              <div class="streak-item">
                <span class="streak-num">{streakData.currentStreak}</span>
                <span>Current Streak</span>
              </div>
              <div class="streak-item">
                <span class="streak-num">{streakData.longestStreak}</span>
                <span>Longest Streak</span>
              </div>
            </div>
            <div class="heatmap-wrapper">
              <div class="heatmap-grid">
                {heatmapWeeks.map((week) => (
                  <div class="heatmap-week">
                    {week.map((day) => {
                      let color = '#161b22';
                      if (day.count > 0) {
                        if (day.count < 3) color = '#0e4429';
                        else if (day.count < 6) color = '#006d32';
                        else if (day.count < 10) color = '#26a641';
                        else color = '#39d353';
                      }
                      const isFuture = day.date > new Date();
                      return (
                        <div
                          class="heatmap-cell"
                          style={`background-color: ${isFuture ? '#161b22' : color}; opacity: ${isFuture ? 0.3 : 1};`}
                          title={isFuture ? 'Future' : `${day.key}: ${day.count} contributions`}
                        />
                      );
                    })}
                  </div>
                ))}
              </div>
              <div class="heatmap-labels">
                <div class="day-labels">
                  <span>Mon</span>
                  <span>Wed</span>
                  <span>Fri</span>
                  <span>Sun</span>
                </div>
              </div>
            </div>
            <p class="heatmap-label">Last 6 months (since 2026)</p>
          </>
        ) : (
          <p class="stat-error">Unable to load contributions. <a href="https://github.com/anshumanhq" target="_blank">View GitHub</a></p>
        )}
        <div class="stat-box-cta">
          <a href="https://github.com/anshumanhq" target="_blank" class="btn btn-outline btn-sm">View GitHub →</a>
        </div>
      </div>
    </div>

    <!-- Top Languages -->
    <div class="top-languages">
      <h3 class="heading-font" style="font-size:1.2rem; text-align:center; margin-top:40px;">
        Top <span class="gradient-text">Languages</span>
      </h3>
      <div class="lang-tags">
        {Object.keys(languageCounts).length > 0 ? (
          Object.entries(languageCounts).map(([lang, count]) => (
            <span class="lang-tag">{lang} ({count} repos)</span>
          ))
        ) : (
          <span class="lang-tag">No languages detected</span>
        )}
      </div>
    </div>
  </section>

  <!-- ===== Featured Projects ===== -->
  <section class="section">
    <div class="eyebrow">Featured Work</div>
    <h2 class="heading-font">Projects that <span class="gradient-text">ship & scale</span></h2>
    <div class="projects-grid">
      {featured.map(p => <ProjectCard p={p} />)}
    </div>
    <div class="center-btn"><a href="/projects/" class="btn btn-outline">View All Projects →</a></div>
  </section>

  <!-- ===== Recent Certificates ===== -->
  <section class="section cert-preview">
    <div class="eyebrow">Recent Certificates</div>
    <h2 class="heading-font">Continuous <span class="gradient-text">Learning & Growth</span></h2>
    <div class="cert-preview-grid">
      {recentCerts.map(c => (
        <div class="card cert-preview-card">
          <div class="cert-preview-image">
            <img src={c.image} alt={c.name} loading="lazy" />
          </div>
          <div class="cert-preview-body">
            <span class="cert-preview-issuer">{c.issuer}</span>
            <h3>{c.name}</h3>
          </div>
        </div>
      ))}
    </div>
    <div class="center-btn"><a href="/certificates/" class="btn btn-outline">View All Certificates →</a></div>
  </section>

  <!-- ===== Quick Links ===== -->
  <section class="quick-links-section">
    <div class="container quick-grid">
      <a href="/about/" class="quick-card"><span class="quick-icon">👨‍💻</span><h3>About Me</h3><p>My journey, mission, and vision.</p></a>
      <a href="/skills/" class="quick-card"><span class="quick-icon">🛠️</span><h3>Skills</h3><p>Languages, frameworks & tools.</p></a>
      <a href="/research/" class="quick-card"><span class="quick-icon">📄</span><h3>Research</h3><p>Publications & research interests.</p></a>
      <a href="/contact/" class="quick-card"><span class="quick-icon">📬</span><h3>Contact</h3><p>Let's collaborate.</p></a>
    </div>
  </section>

  <div class="container ad-container">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2633513915753897" data-ad-slot="2339071842" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <Footer />
</Layout>

<style>
  .hero { position: relative; padding: 150px 24px 60px; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; z-index: 0; }
  .orb1 { width: 460px; height: 460px; background: var(--accent); top: -140px; right: -100px; }
  .orb2 { width: 360px; height: 360px; background: var(--accent-2); bottom: -80px; left: -80px; }
  .hero-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; align-items: center; }
  .badge { margin-bottom: 20px; }
  .hero h1 { font-size: clamp(2.2rem, 5.2vw, 3.6rem); margin: 16px 0; }
  .tagline { color: var(--accent-2); font-weight: 600; font-size: 1.1rem; margin-bottom: 14px; }
  .desc { color: var(--text-dim); max-width: 520px; margin-bottom: 30px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-image { display: flex; justify-content: center; }
  .hero-image img { width: 100%; max-width: 320px; aspect-ratio: 1/1; object-fit: cover; border-radius: 50%; border: 4px solid var(--accent); box-shadow: var(--shadow-glow); }
  .hero-stats { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 70px; padding-top: 40px; border-top: 1px solid var(--border); }
  .stat-card { text-align: center; }
  .stat-num { display: block; font-size: 2.2rem; font-weight: 700; font-family: 'Space Grotesk'; }
  .stat-card span:last-child { color: var(--text-dim); font-size: 0.85rem; }

  /* ===== Coding Stats ===== */
  .coding-stats .heading-font { margin-bottom: 44px; }
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 800px; margin: 0 auto; }
  .stat-box { padding: 28px 24px; text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); backdrop-filter: blur(10px); display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .stat-box-header { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 6px; }
  .stat-box-header img { width: 32px; height: 32px; object-fit: contain; }
  .stat-box-title { font-weight: 700; font-size: 1.2rem; font-family: 'Space Grotesk', sans-serif; }
  .leetcode-card-img { width: 100%; max-width: 320px; border-radius: 8px; transition: transform 0.2s; }
  .leetcode-card-img:hover { transform: scale(1.02); }
  .hackerrank-badges { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; margin: 10px 0; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .badge-icon-img { width: 50px; height: 50px; object-fit: contain; }
  .badge-label { font-size: 0.85rem; font-weight: 500; color: var(--text-dim); }
  .badge-stars { display: flex; gap: 2px; }
  .badge-stars .star { font-size: 0.9rem; color: #555; transition: color 0.2s; }
  .badge-stars .star.filled { color: #f5c842; }
  .stat-box-cta { margin-top: 8px; }
  .btn-sm { padding: 9px 16px; font-size: 0.82rem; }

  /* ===== GitHub Stats ===== */
  .github-stats .heading-font { margin-bottom: 44px; }
  .github-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 900px; margin: 0 auto; }
  .github-box { padding: 24px 20px; height: 100%; min-height: 280px; display: flex; flex-direction: column; }
  .user-detail { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .user-avatar img { border-radius: 50%; border: 2px solid var(--accent); }
  .user-info h3 { font-size: 1.2rem; margin: 0; }
  .user-info p { color: var(--text-dim); font-size: 0.85rem; margin: 4px 0 0; }
  .user-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; width: 100%; margin: 12px 0; }
  .mini-stat { text-align: center; background: var(--bg-soft); padding: 8px 4px; border-radius: var(--radius-sm); }
  .mini-stat-num { display: block; font-size: 1.4rem; font-weight: 700; font-family: 'Space Grotesk'; color: var(--accent-2); }
  .mini-stat-label { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }

  .streak-stats { display: flex; justify-content: center; gap: 30px; margin: 12px 0; }
  .streak-item { text-align: center; }
  .streak-num { display: block; font-size: 1.8rem; font-weight: 700; font-family: 'Space Grotesk'; background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .streak-item span:last-child { font-size: 0.75rem; color: var(--text-dim); }

  .heatmap-wrapper { width: 100%; overflow-x: auto; padding: 4px 0; }
  .heatmap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14px, 1fr)); gap: 3px; width: 100%; min-width: 500px; }
  .heatmap-week { display: grid; grid-template-rows: repeat(7, 1fr); gap: 3px; }
  .heatmap-cell { aspect-ratio: 1; border-radius: 2px; min-width: 10px; min-height: 10px; background-color: #161b22; transition: transform 0.1s; cursor: default; }
  .heatmap-cell:hover { transform: scale(1.5); z-index: 2; }
  .heatmap-labels { margin-top: 8px; }
  .day-labels { display: grid; grid-template-columns: 30px 1fr; gap: 4px; align-items: center; font-size: 0.65rem; color: var(--text-dim); padding-left: 4px; }
  .day-labels span { padding: 2px 0; text-align: left; }
  .heatmap-label { font-size: 0.75rem; color: var(--text-dim); text-align: center; margin-top: 8px; }

  .top-languages { margin-top: 20px; text-align: center; }
  .lang-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 12px; }
  .lang-tag { padding: 6px 14px; border-radius: 100px; background: var(--surface); border: 1px solid var(--border); font-size: 0.8rem; color: var(--text-dim); }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; margin-top: 44px; }
  .center-btn { text-align: center; margin-top: 40px; }

  .cert-preview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 44px; }
  .cert-preview-card { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); transition: transform 0.3s, border-color 0.3s; }
  .cert-preview-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .cert-preview-image { width: 100%; aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 14px; }
  .cert-preview-image img { width: 100%; height: 100%; object-fit: contain; background: var(--bg-soft); }
  .cert-preview-issuer { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-2); font-weight: 600; }
  .cert-preview-body h3 { font-size: 0.95rem; margin-top: 6px; line-height: 1.3; }

