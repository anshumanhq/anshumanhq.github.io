---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout title="Projects" description="Explore 60+ projects by Anshuman Singh including AI platforms, Flask web apps, commercial software, and open-source libraries.">
  <div class="py-8">
    <h1 class="text-4xl font-bold text-center gradient-text">All Projects</h1>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
